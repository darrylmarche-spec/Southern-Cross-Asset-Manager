# ── Database ──────────────────────────────────────────────────────────────────
# Neon (or any PostgreSQL) connection string
DATABASE_URL=postgresql://user:password@host/dbname

# ── Session ───────────────────────────────────────────────────────────────────
# Must be a long, random secret. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ── Seed user passwords (Fix #12) ─────────────────────────────────────────────
# Passwords for the default admin accounts created at server startup.
# These are hashed before storage; rotate them after the first deployment.
SEED_PASSWORD_DAVOR=change-me
SEED_PASSWORD_DARRYL=change-me

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Expo / Replit (optional) ──────────────────────────────────────────────────
# EXPO_PUBLIC_DOMAIN=your-replit-dev-domain
# REPLIT_DEV_DOMAIN=your-replit-dev-domain
